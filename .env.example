NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Flutterwave ----------------------------------------------------------
# Card checkout only appears when both keys are set.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# Any random string you choose. Paste the SAME value into
# Flutterwave > Settings > Webhooks > Secret hash, or every webhook is rejected
# and no order is ever marked paid.
FLUTTERWAVE_SECRET_HASH=
NEXT_PUBLIC_APP_URL=https://afunwa-hairline.vercel.app
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
# Optional: protects /api/keep-alive. Vercel cron sends it automatically.
CRON_SECRET=

# --- Single-store launch flags -------------------------------------------
# Vendor browsing (Find Vendors tab, Stores search filter). Turn on when there
# is more than one store worth browsing.
NEXT_PUBLIC_ENABLE_VENDOR_DISCOVERY=false
# Lets any signed-in buyer open their own store. Keep false until we want
# other vendors selling here.
NEXT_PUBLIC_ENABLE_SELLER_SIGNUP=false
# Comma separated emails that keep seller access while signup is closed.
# UI lock only — it ships in the client bundle, so Supabase RLS is the real gate.
NEXT_PUBLIC_SELLER_EMAILS=

# --- Address lookup -------------------------------------------------------
# Google Places key for the region and city suggestions at checkout. NOT
# prefixed NEXT_PUBLIC: it is proxied through /api/places so it never reaches
# the browser. Enable "Places API (New)" on the key, restrict it to that API,
# and set a daily quota cap — a server key cannot be locked to a referrer.
# Leave blank and checkout falls back to the Nigerian state list, as before.
GOOGLE_PLACES_API_KEY=
